# /etc/systemd/system/sckda-jewel.service
[Unit]
Description=SCKDA Gold & Silver Articles Inventory
After=network.target

[Service]
Type=simple
User=sckda-jewel
WorkingDirectory=/opt/sckda-jewel
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/var/lib/sckda-jewel
Environment=ADMIN_USERNAME=superadmin
ExecStart=/usr/bin/node --no-warnings server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sckda-jewel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
